# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose to the client, never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Payments
# ---------------------------------------------------------------------------
# No payment gateway has been finalized for GMUN 5.0. Leave unset (or set to
# "mock") to use the built-in development payment simulator. Only set this
# once a real provider has been selected and configured.
# One of: mock | razorpay | cashfree | payment-link
PAYMENT_PROVIDER=mock

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=
# sandbox | production
CASHFREE_ENV=sandbox

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Email — delegate emails on submit / confirm / reject (lib/email/templates.ts)
# ---------------------------------------------------------------------------
# "resend" to send; leave empty to skip sending (logged instead).
EMAIL_PROVIDER=
# Resend API key (a "Sending access" key is enough).
RESEND_API_KEY=
# Must be on a domain verified in Resend — e.g. "GMUN 5.0 <noreply@mail.example.com>".
# Gmail / other free-mail addresses cannot be used as the sender.
EMAIL_FROM=
# Where delegate replies go (defaults to the contact email in config/contact.ts).
EMAIL_REPLY_TO=
ADMIN_EMAIL=
